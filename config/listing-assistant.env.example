# Copy selected values into your ignored local environment, or your server service environment.
# Photos are sent to MiniMax only after the signed-in owner explicitly requests recognition.
MAIMAI_LISTING_AI_ENABLED=false
MAIMAI_LISTING_AI_BASE_URL=https://api.minimaxi.com/v1
MAIMAI_LISTING_AI_MODEL=MiniMax-M3
# May be omitted to reuse MAIMAI_GOVERNANCE_API_KEY from the same service environment.
MAIMAI_LISTING_AI_API_KEY=
MAIMAI_LISTING_AI_DAILY_LIMIT=10
MAIMAI_LISTING_AI_USER_DAILY_LIMIT=3
# Daily limits use Asia/Shanghai. Failures count too; no automatic billed retry.
# Same owner's identical photos reuse successful results for 24 hours.
# Onsite comparison only reads eligible product records and does not call a model.
