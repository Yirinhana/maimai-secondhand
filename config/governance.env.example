# Copy to .local/private/governance.env for local development; never commit the filled file.
# This dedicated background service calls MiniMax directly. Existing Hermes chat stays independent.
MAIMAI_GOVERNANCE_ENABLED=false
MAIMAI_GOVERNANCE_BASE_URL=https://api.minimaxi.com/v1
MAIMAI_GOVERNANCE_API_KEY=
# Use an actual model identifier available to your provider account.
MAIMAI_GOVERNANCE_MODEL=
MAIMAI_GOVERNANCE_DAILY_LIMIT=20
MAIMAI_GOVERNANCE_GAP_SECONDS=30
