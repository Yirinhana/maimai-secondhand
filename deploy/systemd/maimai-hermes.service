[Unit]
Description=Maimai website Hermes advice (no tools or personal memory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maimai-hermes
Group=maimai-hermes
StateDirectory=maimai-hermes
StateDirectoryMode=0700
WorkingDirectory=/var/lib/maimai-hermes
Environment=HOME=/var/lib/maimai-hermes
Environment=HERMES_HOME=/var/lib/maimai-hermes
Environment=PYTHONPATH=/opt/maimai-hermes/runtime:/opt/maimai-hermes/runtime/venv/lib/python3.11/site-packages
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/maimai/hermes-site.env
ExecStart=/opt/maimai-hermes/python/bin/python3.11 /opt/maimai-hermes/hermes-site-gateway.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=tmpfs
BindReadOnlyPaths=/opt/hermes/runtime:/opt/maimai-hermes/runtime
BindReadOnlyPaths=/opt/hermes/python:/opt/maimai-hermes/python
ProtectSystem=strict
ReadWritePaths=/var/lib/maimai-hermes
InaccessiblePaths=/etc/maimai/maimai.env
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
UMask=0077
MemoryHigh=240M
MemoryMax=320M
TasksMax=64

[Install]
WantedBy=multi-user.target
