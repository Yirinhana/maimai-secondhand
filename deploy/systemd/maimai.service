[Unit]
Description=Maimai marketplace API
After=network-online.target maimai-mysql.service
Requires=maimai-mysql.service
Wants=network-online.target

[Service]
Type=simple
User=maimai
Group=maimai
WorkingDirectory=/opt/maimai/current
EnvironmentFile=/etc/maimai/maimai.env
ExecStart=/usr/bin/java -Xms96m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError -jar /opt/maimai/current/backend.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/maimai
MemoryHigh=640M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
