[mysqld]
basedir=/opt/maimai/runtime/mysql/usr
datadir=/var/lib/maimai/mysql
socket=/run/maimai-mysql/mysql.sock
pid-file=/run/maimai-mysql/mysql.pid
bind-address=127.0.0.1
port=3306
mysqlx=0
skip-name-resolve
max_connections=30
innodb_buffer_pool_size=128M
innodb_redo_log_capacity=64M
performance_schema=OFF
table_open_cache=256
table_definition_cache=400
tmp_table_size=8M
max_heap_table_size=8M
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=+00:00
log-error=/var/lib/maimai/mysql/error.log
secure-file-priv=NULL
local-infile=OFF

[client]
socket=/run/maimai-mysql/mysql.sock
