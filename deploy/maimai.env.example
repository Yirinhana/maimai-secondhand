# 复制到服务器 /etc/maimai/maimai.env，权限0600，逐项配置；本文件不含凭据。
MAIMAI_DB_HOST=127.0.0.1
MAIMAI_DB_PORT=3306
MAIMAI_DB_USER=maimai
MAIMAI_DB_PASSWORD=
# 示例域名；替换为自己的 HTTPS 域名并核对证书覆盖
MAIMAI_FRONTEND_ORIGIN=https://market.example.com
MAIMAI_UPLOAD_DIR=/var/lib/maimai/uploads
MAIMAI_AVATAR_DIR=/var/lib/maimai/avatars
MAIMAI_MESSAGE_IMAGE_DIR=/var/lib/maimai/private-message-images
MAIMAI_AFTERSALE_IMAGE_DIR=/var/lib/maimai/private-aftersale-images
MAIMAI_MAIL_PROVIDER=smtp
MAIMAI_MAIL_FROM=
MAIMAI_SMTP_HOST=
MAIMAI_SMTP_PORT=465
MAIMAI_SMTP_USERNAME=
MAIMAI_SMTP_PASSWORD=
# true=隐式TLS(通常465)，false=强制STARTTLS(通常587)，不能明文发信
MAIMAI_SMTP_SSL=true
# 以下两项是JSAPI配置；安全码仅用于后端代理
MAIMAI_AMAP_JS_KEY=
MAIMAI_AMAP_SECURITY_CODE=
# 独立Web服务Key；没有则保留空，不能填JSAPI Key
MAIMAI_AMAP_KEY=
MAIMAI_KUAIDI100_CUSTOMER=
MAIMAI_KUAIDI100_KEY=
MAIMAI_PAY_CHANNEL=wechat
# 微信平台收付通资质与渠道实现尚待开通及验收，填写参数不代表支付已可用
MAIMAI_WECHAT_MCH_ID=
MAIMAI_WECHAT_APP_ID=
MAIMAI_WECHAT_API_KEY=
MAIMAI_WECHAT_CERT_PATH=
# 人工客服不依赖AI；只有专用Hermes实例已核实禁用工具能力后才可启用
MAIMAI_HERMES_BASE_URL=
MAIMAI_HERMES_TOKEN=
MAIMAI_HERMES_MODEL=
MAIMAI_HERMES_READONLY_VERIFIED=false
